# 32 bytes. Generate: openssl rand -hex 32
APP_ENC_KEY=

# Required for public deployments; if unset, all access is rejected (fail-closed).
DASHBOARD_PASSWORD=

# Falls back to APP_ENC_KEY if unset. Generate: openssl rand -hex 32
AUTH_SECRET=

# NEVER enable in production.
AUTH_DISABLED=false

# Relative to the apps/web working directory
DATABASE_PATH=./data/quota.sqlite

# Prints raw quota API responses to the server console. Never enable in production.
DEBUG=false

# Seconds. Default 300 (5min), floor 60 (1min).
# The upstream usage endpoints rate-limit (HTTP 429) faster polling; don't go below 60.
POLL_INTERVAL_SECONDS=300

ENABLE_POLLER=true

# ---- Quota-reset notifications (optional) ----
# Feishu (Lark) custom-bot webhook; unset = notifications disabled.
# Create one: Feishu group settings → Bots (群机器人) → Add Custom Bot (自定义机器人).
FEISHU_WEBHOOK_URL=

# Optional: the bot's signature-verification secret.
FEISHU_WEBHOOK_SECRET=

# Only notify when a window had reached this used% before resetting.
# Default 80; 0 = notify on every detected reset.
# Weekly (7-day) windows are exempt: their resets always notify.
NOTIFY_MIN_USED_PERCENT=80

# ---- Low-quota and provider-health alerts (same Feishu bot) ----
# Disable these alerts without disabling quota-reset / startup notifications.
NOTIFY_ALERTS_ENABLED=true

# Comma-separated used percentages, ascending or unordered. Empty disables percentage alerts.
NOTIFY_USAGE_THRESHOLDS=80,95

# Optional JSON map: balance thresholds in each provider's displayed unit.
# Example: {"moonshot":5,"rightapi":5,"codex":100}
# All accounts of a provider share its threshold; delivery is deduplicated per account.
# The legacy codex2 key can still override the migrated second account.
# Codex uses Credits; Moonshot follows its configured region. No currency conversion.
NOTIFY_BALANCE_THRESHOLDS={}

# Alert after this many consecutive failed fetches; rejected credentials alert immediately.
NOTIFY_FAILURE_THRESHOLD=3

# Repeat an unresolved warning at most every 6 hours per provider / metric / channel.
# Higher percentage thresholds and escalation to credential errors alert immediately.
NOTIFY_COOLDOWN_SECONDS=21600

# Warn when data is stale. Effective minimum is three polling intervals.
# Stale checks run only while the background poller is enabled.
NOTIFY_STALE_SECONDS=1800

# Notify on the next successful fetch after a delivered provider-health warning.
NOTIFY_RECOVERY=true

# Optional absolute http(s) URL for the "open dashboard" link in alert messages.
DASHBOARD_URL=
